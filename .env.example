NODE_ENV=production
HOST=0.0.0.0
PORT=4173
DATA_DIR=./storage
SESSION_DAYS=30

# Generate long random values before deployment. Do not reuse these examples.
ADMIN_TOKEN=replace-with-at-least-32-random-characters
PURCHASE_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
PHONE_HASH_SECRET=replace-with-a-separate-at-least-32-random-characters

# Set to 1 when HTTPS is active.
COOKIE_SECURE=1

# If your Node server runs behind a reverse proxy:
TRUST_PROXY=1

# Optional: forward issued codes to an SMS / messaging automation endpoint.
# DELIVERY_WEBHOOK_URL=https://your-automation.example.com/send-code
# DELIVERY_WEBHOOK_SECRET=another-long-random-secret
